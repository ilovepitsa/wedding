# === Обязательные параметры ===

# OAuth-приложение из console.yandex.cloud (раздел "ID сервиса")
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Папка на Яндекс.Диске (должна существовать заранее)
YANDEX_FOLDER=/wedding/photos


# === После первой авторизации ===
# Refresh token появится в логах бэкенда после входа через /auth/login.
# Сохраните его сюда — тогда при следующем запуске авторизация произойдёт автоматически.
YANDEX_REFRESH_TOKEN=

# === Mock-режим (локальная разработка без реального диска) ===
# Запустить мок: cd backend && go run ./mockdisk
# Затем раскомментировать:
# YANDEX_API_BASE=http://mockdisk:9999/v1/disk


# === Способ загрузки ===
# simple  — каждый файл одним запросом (поведение по умолчанию)
# chunked — файлы крупнее 10 МБ режутся на чанки по 4 МБ с ретраями и resume
UPLOAD_MODE=simple

# === Параметры чанкового режима (только при UPLOAD_MODE=chunked) ===
# Каталог для временной сборки чанков (бэкенд)
# UPLOAD_TMP_DIR=/app/tmp_uploads
# Срок жизни недокачанных файлов, после которого их удаляет GC
# UPLOAD_GC_TTL=6h
